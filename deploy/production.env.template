# ---------------------------------------------------------------------------
# Production environment template.
#
# deploy/provision.sh renders this into shared/.env on the server and replaces
# every __PLACEHOLDER__ with a value generated there. No secret is ever stored
# in the repository, and the rendered file never leaves the server.
#
# Both blue/green colours mount the same rendered file, which is what keeps
# APP_KEY, the session cookie and the database credentials identical across a
# flip: a visitor keeps their session and their encrypted cookies stay readable.
# ---------------------------------------------------------------------------

APP_NAME="هنرستان جوار شرکت پالایش نفت بندرعباس"
APP_ENV=production
APP_KEY=__APP_KEY__
APP_DEBUG=false
APP_URL=__APP_URL__

APP_LOCALE=fa
APP_FALLBACK_LOCALE=fa
APP_FAKER_LOCALE=fa_IR
APP_TIMEZONE=Asia/Tehran

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=daily
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# ---------------------------------------------------------------------------
# Database - the dedicated cc-data MySQL, reached over the shared docker
# network. DB_ROOT_PASSWORD is read by deploy/compose.data.yaml only.
# ---------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=creativitycenter
DB_USERNAME=creativitycenter
DB_PASSWORD=__DB_PASSWORD__
DB_ROOT_PASSWORD=__DB_ROOT_PASSWORD__
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ---------------------------------------------------------------------------
# Redis - the dedicated cc-data instance. The queue, Horizon and the cache
# share it; the cache also provides the locks behind `migrate --isolated` and
# the scheduler's onOneServer().
# ---------------------------------------------------------------------------
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=__REDIS_PASSWORD__
REDIS_PORT=6379

# Database sessions: both colours read the same table, so a flip never logs a
# visitor out. SECURE_COOKIE stays false while the site is plain HTTP on a
# temporary port - set it to true together with the TLS certificate.
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax

FILESYSTEM_DISK=local
MEDIA_DISK=public

CACHE_STORE=redis
CACHE_PREFIX=creativitycenter-

QUEUE_CONNECTION=redis

# The public website broadcasts nothing (resources/js/app.js does not import
# ./echo), so no Reverb service is part of the production stack.
BROADCAST_CONNECTION=null

MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@creativitycenter.local"
MAIL_FROM_NAME="هنرستان جوار شرکت پالایش نفت بندرعباس"

# imagick is the only image engine the application image installs.
IMAGE_DRIVER=imagick

# Empty keeps the Horizon dashboard closed outside the local environment.
HORIZON_ALLOWED_EMAILS=

# deploy/deploy.sh owns the migrations; a container must not run them on start.
AUTO_MIGRATE=false