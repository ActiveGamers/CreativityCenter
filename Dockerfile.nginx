# syntax=docker/dockerfile:1
#
# Edge image of one blue/green colour: nginx plus the public/ tree of the very
# same release.
#
# The assets are baked in rather than bind mounted so that a colour is an
# immutable unit: the app image and its web image are built from one commit and
# carry one tag. During a deploy the two colours therefore serve two asset
# generations side by side, and a page rendered by the outgoing colour can
# still fetch its own hashed files after the upstream has flipped.
#
#   docker build -f Dockerfile.nginx \
#     --build-arg APP_IMAGE=ghcr.io/activegamers/creativitycenter:sha-abc1234 \
#     -t ghcr.io/activegamers/creativitycenter-web:sha-abc1234 .

ARG APP_IMAGE
FROM ${APP_IMAGE} AS app

FROM nginx:alpine

COPY docker/nginx/prod.conf /etc/nginx/conf.d/default.conf
COPY --from=app /var/www/html/public /var/www/html/public

# public/storage is created by the app entrypoint at start up, so it is not part
# of the build context. Here it is a link into the shared storage volume that
# both colours mount at the same path.
RUN ln -sfn /var/www/html/storage/app/public /var/www/html/public/storage \
    && test -f /var/www/html/public/build/manifest.json \
    && test -f /var/www/html/public/index.php \
    && nginx -t

EXPOSE 80